<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Layer 1: 민트 → 라벤더 대각선 그라데이션 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#A8D8A8"
                android:endColor="#C4A8D4"
                android:angle="135"
                android:type="linear" />
        </shape>
    </item>

    <!-- Layer 2: 상단 투명 → 하단 배경색으로 서서히 페이드 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#00F2F2F7"
                android:centerColor="#55F2F2F7"
                android:endColor="#F2F2F7"
                android:angle="270"
                android:type="linear" />
        </shape>
    </item>

</layer-list>
