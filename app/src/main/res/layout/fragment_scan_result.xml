<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scan_overlay_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_previous"
                android:contentDescription="뒤로"
                android:tint="@color/on_background" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/result_title"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/on_background"
                android:gravity="center" />

            <View android:layout_width="40dp" android:layout_height="40dp" />
        </LinearLayout>

        <!-- Captured Photo + Acne Overlay -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="20dp">

            <ImageView
                android:id="@+id/iv_captured_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_camera" />

            <com.example.soboroskin.OverlayView
                android:id="@+id/overlay_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent" />
        </FrameLayout>

        <!-- Skin Type -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/result_skin_type"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tv_skin_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="건성"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Score Cards -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Moisture -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="💧 수분"
                        android:textSize="14sp"
                        android:textColor="@color/on_background" />
                    <TextView
                        android:id="@+id/tv_moisture_score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="78점"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent_moisture"
                        android:layout_marginEnd="8dp" />
                    <ProgressBar
                        android:id="@+id/progress_moisture"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="120dp"
                        android:layout_height="8dp"
                        android:max="100"
                        android:progress="78"
                        android:progressTint="@color/accent_moisture"
                        android:progressBackgroundTint="@color/surface_variant" />
                </LinearLayout>

                <!-- Oil -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="✨ 유분"
                        android:textSize="14sp"
                        android:textColor="@color/on_background" />
                    <TextView
                        android:id="@+id/tv_oil_score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="45점"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent_oil"
                        android:layout_marginEnd="8dp" />
                    <ProgressBar
                        android:id="@+id/progress_oil"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="120dp"
                        android:layout_height="8dp"
                        android:max="100"
                        android:progress="45"
                        android:progressTint="@color/accent_oil"
                        android:progressBackgroundTint="@color/surface_variant" />
                </LinearLayout>

                <!-- Trouble -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🔴 트러블"
                        android:textSize="14sp"
                        android:textColor="@color/on_background" />
                    <TextView
                        android:id="@+id/tv_trouble_score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30점"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent_trouble"
                        android:layout_marginEnd="8dp" />
                    <ProgressBar
                        android:id="@+id/progress_trouble"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="120dp"
                        android:layout_height="8dp"
                        android:max="100"
                        android:progress="30"
                        android:progressTint="@color/accent_trouble"
                        android:progressBackgroundTint="@color/surface_variant" />
                </LinearLayout>

                <!-- Elasticity -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="💜 탄력"
                        android:textSize="14sp"
                        android:textColor="@color/on_background" />
                    <TextView
                        android:id="@+id/tv_elasticity_score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="65점"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent_elasticity"
                        android:layout_marginEnd="8dp" />
                    <ProgressBar
                        android:id="@+id/progress_elasticity"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="120dp"
                        android:layout_height="8dp"
                        android:max="100"
                        android:progress="65"
                        android:progressTint="@color/accent_elasticity"
                        android:progressBackgroundTint="@color/surface_variant" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- AI Comment -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/primary_light">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="top">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🤖"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tv_ai_comment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="수분이 부족한 상태예요. 보습 크림과 수분 에센스를 충분히 사용해 보세요."
                    android:textSize="14sp"
                    android:textColor="@color/primary_dark"
                    android:lineSpacingMultiplier="1.5" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Action Buttons -->
        <Button
            android:id="@+id/btn_save_to_diary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_button_primary"
            android:text="@string/result_save"
            android:textColor="@color/on_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_retry"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_outline"
            android:text="@string/result_retry"
            android:textColor="@color/primary"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
