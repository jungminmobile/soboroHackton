<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen_gradient">

    <!-- ══ 헤더: 로고 + 타이틀 (투명 → 그라데이션 비침) ══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/transparent">

        <!-- 앱 로고 + 이름 행 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="52dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="화장품 추천"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/on_primary"
                android:letterSpacing="-0.02"
                android:layout_marginStart="10dp" />

        </LinearLayout>

        <!-- AI 피부 분석 배너 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_banner_translucent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨"
                android:textSize="20sp"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/tv_skin_type_recommend"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="내 피부 타입에 맞는 화장품을 AI가 추천해드려요"
                android:textSize="13sp"
                android:textColor="@color/on_primary"
                android:lineSpacingMultiplier="1.3" />
        </LinearLayout>

        <!-- 탭 레이아웃 (투명) -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout_cosmetics"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            app:tabSelectedTextColor="@color/on_primary"
            app:tabTextColor="#AAFFFFFF"
            app:tabIndicatorColor="@color/on_primary"
            app:tabIndicatorHeight="3dp"
            app:tabMode="scrollable"
            app:tabGravity="fill" />

    </LinearLayout>

    <!-- ══ ViewPager2 (투명 → 그라데이션 비침) ══════════════════ -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewpager_cosmetics"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/transparent" />

</LinearLayout>
