<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- ── 데이터 있을 때: 날짜 네비 + 스크롤 컨텐츠 ──────────── -->
    <LinearLayout
        android:id="@+id/layout_has_data"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 날짜 네비게이션 (왼쪽 붙은 작은 둥근 박스) -->
        <LinearLayout
            android:id="@+id/layout_date_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="4dp">

            <!-- 둥근 날짜 박스 (왼쪽 정렬, wrap_content) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_date_nav_box"
                android:elevation="3dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <ImageButton
                    android:id="@+id/btn_prev"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_diary_chevron_left"
                    android:contentDescription="이전"
                    android:tint="@color/on_background" />

                <TextView
                    android:id="@+id/tv_date_nav"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_background"
                    android:paddingHorizontal="4dp" />

                <ImageButton
                    android:id="@+id/btn_next"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_diary_chevron_right"
                    android:contentDescription="다음"
                    android:tint="@color/on_background" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="16dp"
                    android:background="@color/divider"
                    android:layout_marginHorizontal="2dp" />

                <ImageButton
                    android:id="@+id/btn_delete_entry"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_diary_delete"
                    android:contentDescription="삭제"
                    android:tint="@color/text_secondary" />

            </LinearLayout>

            <!-- 카운터 (박스 오른쪽에 작게) -->
            <TextView
                android:id="@+id/tv_entry_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="@color/text_hint"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- 스크롤 컨텐츠 -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="100dp">

                <!-- ── 피부 분석 카드 (오각형 + 점수) ──────── -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/surface"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="피부 분석"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="230dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <com.example.soboroskin.ui.diary.PentagonChartView
                                android:id="@+id/pentagon_chart"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1.4" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center_vertical"
                                android:paddingStart="8dp">

                                <!-- 수분 -->
                                <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
                                    android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
                                    <View android:layout_width="3dp" android:layout_height="28dp"
                                        android:background="@color/accent_moisture" android:layout_marginEnd="10dp" />
                                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                                        android:layout_weight="1" android:orientation="vertical">
                                        <TextView android:text="수분" android:textSize="11sp" android:textColor="@color/text_secondary"
                                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                                            android:orientation="horizontal" android:gravity="center_vertical">
                                            <TextView android:id="@+id/tv_delta_moisture" android:layout_width="wrap_content"
                                                android:layout_height="wrap_content" android:textSize="10sp"
                                                android:layout_marginEnd="3dp" android:visibility="gone"/>
                                            <TextView android:id="@+id/tv_val_moisture" android:layout_width="wrap_content"
                                                android:layout_height="wrap_content" android:text="--"
                                                android:textSize="20sp" android:textStyle="bold" android:textColor="@color/on_background"/>
                                        </LinearLayout>
                                    </LinearLayout>
                                </LinearLayout>

                                <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="@color/divider"/>

                                <!-- 건조함 -->
                                <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
                                    android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
                                    <View android:layout_width="3dp" android:layout_height="28dp"
                                        android:background="@color/accent_oil" android:layout_marginEnd="10dp" />
                                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                                        android:layout_weight="1" android:orientation="vertical">
                                        <TextView android:text="건조함" android:textSize="11sp" android:textColor="@color/text_secondary"
                                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                                            android:orientation="horizontal" android:gravity="center_vertical">
                                            <TextView android:id="@+id/tv_delta_dryness" android:layout_width="wrap_content"
                                                android:layout_height="wrap_content" android:textSize="10sp"
                                                android:layout_marginEnd="3dp" android:visibility="gone"/>
                                            <TextView android:id="@+id/tv_val_dryness" android:layout_width="wrap_content"
                                                android:layout_height="wrap_content" android:text="--"
                                                android:textSize="20sp" android:textStyle="bold" android:textColor="@color/on_background"/>
                                        </LinearLayout>
                                    </LinearLayout>
                                </LinearLayout>

                                <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="@color/divider"/>

                                <!-- 여드름 -->
                                <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
                                    android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
                                    <View android:layout_width="3dp" android:layout_height="28dp"
                                        android:background="@color/accent_trouble" android:layout_marginEnd="10dp" />
                                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                                        android:layout_weight="1" android:orientation="vertical">
                                        <TextView android:text="여드름" android:textSize="11sp" android:textColor="@color/text_secondary"
                                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                                            android:orientation="horizontal" android:gravity="center_vertical">
                                            <TextView android:id="@+id/tv_delta_acne" android:layout_width="wrap_content"
                                                android:layout_height="wrap_content" android:textSize="10sp"
                                                android:layout_marginEnd="3dp" android:visibility="gone"/>
                                            <TextView android:id="@+id/tv_val_acne" android:layout_width="wrap_content"
                                                android:layout_height="wrap_content" android:text="--"
                                                android:textSize="20sp" android:textStyle="bold" android:textColor="@color/on_background"/>
                                        </LinearLayout>
                                    </LinearLayout>
                                </LinearLayout>

                                <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="@color/divider"/>

                                <!-- 모공 -->
                                <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
                                    android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
                                    <View android:layout_width="3dp" android:layout_height="28dp"
                                        android:background="#4CAF50" android:layout_marginEnd="10dp" />
                                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                                        android:layout_weight="1" android:orientation="vertical">
                                        <TextView android:text="모공" android:textSize="11sp" android:textColor="@color/text_secondary"
                                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                                            android:orientation="horizontal" android:gravity="center_vertical">
                                            <TextView android:id="@+id/tv_delta_pore" android:layout_width="wrap_content"
                                                android:layout_height="wrap_content" android:textSize="10sp"
                                                android:layout_marginEnd="3dp" android:visibility="gone"/>
                                            <TextView android:id="@+id/tv_val_pore" android:layout_width="wrap_content"
                                                android:layout_height="wrap_content" android:text="--"
                                                android:textSize="20sp" android:textStyle="bold" android:textColor="@color/on_background"/>
                                        </LinearLayout>
                                    </LinearLayout>
                                </LinearLayout>

                                <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="@color/divider"/>

                                <!-- 탄력 -->
                                <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
                                    android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
                                    <View android:layout_width="3dp" android:layout_height="28dp"
                                        android:background="@color/accent_elasticity" android:layout_marginEnd="10dp" />
                                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                                        android:layout_weight="1" android:orientation="vertical">
                                        <TextView android:text="탄력" android:textSize="11sp" android:textColor="@color/text_secondary"
                                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                                            android:orientation="horizontal" android:gravity="center_vertical">
                                            <TextView android:id="@+id/tv_delta_elasticity" android:layout_width="wrap_content"
                                                android:layout_height="wrap_content" android:textSize="10sp"
                                                android:layout_marginEnd="3dp" android:visibility="gone"/>
                                            <TextView android:id="@+id/tv_val_elasticity" android:layout_width="wrap_content"
                                                android:layout_height="wrap_content" android:text="--"
                                                android:textSize="20sp" android:textStyle="bold" android:textColor="@color/on_background"/>
                                        </LinearLayout>
                                    </LinearLayout>
                                </LinearLayout>

                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ── 진단 사진 보러가기 버튼 ───────────────────── -->
                <!-- iv_photo는 Kotlin 참조용으로만 유지 (gone) -->
                <ImageView
                    android:id="@+id/iv_photo"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_photo_notes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/surface"
                    app:strokeWidth="0dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📷"
                            android:textSize="20sp"
                            android:layout_marginEnd="10dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="진단 사진 보러가기"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/on_background" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="사진 탭에서 확인할 수 있어요"
                                android:textSize="11sp"
                                android:textColor="@color/text_secondary"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textSize="22sp"
                            android:textColor="@color/text_secondary" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ── 기간 칩 + 변화 그래프 ──────────────────── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="피부 변화 추이"
                        android:textSize="12sp"
                        android:textAllCaps="true"
                        android:textColor="@color/text_secondary"
                        android:letterSpacing="0.06" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_period"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_7days"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="7일"
                            style="@style/Widget.MaterialComponents.Chip.Choice" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_30days"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="30일"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:checked="true" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_90days"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3개월"
                            style="@style/Widget.MaterialComponents.Chip.Choice" />

                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/surface"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="선택한 날짜가 ┆ 로 표시됩니다"
                            android:textSize="11sp"
                            android:textColor="@color/text_hint"
                            android:layout_marginBottom="8dp" />

                        <com.github.mikephil.charting.charts.LineChart
                            android:id="@+id/line_chart"
                            android:layout_width="match_parent"
                            android:layout_height="180dp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:background="@color/divider"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="기간 평균"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="수분" android:textSize="11sp" android:textColor="@color/text_secondary"/>
                                <TextView android:id="@+id/tv_avg_moisture" android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" android:text="-" android:textSize="16sp"
                                    android:textStyle="bold" android:textColor="@color/accent_moisture" android:layout_marginTop="2dp"/>
                            </LinearLayout>

                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="탄력" android:textSize="11sp" android:textColor="@color/text_secondary"/>
                                <TextView android:id="@+id/tv_avg_elasticity" android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" android:text="-" android:textSize="16sp"
                                    android:textStyle="bold" android:textColor="@color/accent_elasticity" android:layout_marginTop="2dp"/>
                            </LinearLayout>

                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="모공" android:textSize="11sp" android:textColor="@color/text_secondary"/>
                                <TextView android:id="@+id/tv_avg_pore" android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" android:text="-" android:textSize="16sp"
                                    android:textStyle="bold" android:textColor="#4CAF50" android:layout_marginTop="2dp"/>
                            </LinearLayout>

                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="여드름" android:textSize="11sp" android:textColor="@color/text_secondary"/>
                                <TextView android:id="@+id/tv_avg_acne" android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" android:text="-" android:textSize="16sp"
                                    android:textStyle="bold" android:textColor="@color/accent_trouble" android:layout_marginTop="2dp"/>
                            </LinearLayout>

                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ── 피부 일기 카드 ─────────────────────────── -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/surface"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="4dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="✏️  피부 일기"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/on_background" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="식습관, 수면, 스트레스 등을 기록해보세요"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_hint"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tv_journal_saved"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✓ 저장됨"
                                android:textSize="11sp"
                                android:textColor="@color/primary"
                                android:visibility="gone" />

                        </LinearLayout>

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="10dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chip_tag_sleep_late"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="😴 늦게 잠"
                                    android:textSize="12sp"
                                    style="@style/Widget.MaterialComponents.Chip.Action"
                                    android:layout_marginEnd="6dp" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chip_tag_junk_food"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="🍕 자극적 음식"
                                    android:textSize="12sp"
                                    style="@style/Widget.MaterialComponents.Chip.Action"
                                    android:layout_marginEnd="6dp" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chip_tag_drink_water"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="💧 물 많이 마심"
                                    android:textSize="12sp"
                                    style="@style/Widget.MaterialComponents.Chip.Action"
                                    android:layout_marginEnd="6dp" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chip_tag_stress"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="😤 스트레스"
                                    android:textSize="12sp"
                                    style="@style/Widget.MaterialComponents.Chip.Action"
                                    android:layout_marginEnd="6dp" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chip_tag_exercise"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="🏃 운동함"
                                    android:textSize="12sp"
                                    style="@style/Widget.MaterialComponents.Chip.Action"
                                    android:layout_marginEnd="6dp" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chip_tag_alcohol"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="🍺 음주"
                                    android:textSize="12sp"
                                    style="@style/Widget.MaterialComponents.Chip.Action" />

                            </LinearLayout>
                        </HorizontalScrollView>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="이 날 피부에 영향을 줄 수 있는 일이 있었나요?"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxStrokeColor="@color/primary"
                            app:hintTextColor="@color/text_hint">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_journal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textMultiLine|textCapSentences"
                                android:minLines="3"
                                android:maxLines="8"
                                android:gravity="top|start"
                                android:textSize="13sp"
                                android:textColor="@color/on_background"
                                android:lineSpacingMultiplier="1.5" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="end"
                            android:layout_marginTop="10dp">

                            <Button
                                android:id="@+id/btn_save_journal"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:text="저장"
                                android:textSize="13sp"
                                android:paddingHorizontal="24dp"
                                style="@style/Widget.MaterialComponents.Button"
                                app:backgroundTint="@color/primary" />

                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ── 진단 시작 버튼 ──────────────────────────── -->
                <Button
                    android:id="@+id/btn_quick_scan"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_gradient_button"
                    android:text="@string/home_scan_btn"
                    android:textColor="@color/on_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:stateListAnimator="@null" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- ── 빈 상태 ────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layout_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋"
            android:textSize="48sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_no_diagnosis"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.5"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btn_quick_scan_empty"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_gradient_button"
            android:text="@string/home_scan_btn"
            android:textColor="@color/on_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingHorizontal="32dp"
            android:stateListAnimator="@null" />

    </LinearLayout>

</FrameLayout>
