<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- 크롭 사진 썸네일 -->
        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginEnd="12dp">

            <ImageView
                android:id="@+id/iv_spot_thumb"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:scaleType="centerCrop"
                android:background="#1A1D9E75" />

            <!-- 사진 없을 때 아이콘 -->
            <TextView
                android:id="@+id/tv_thumb_placeholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="📷"
                android:textSize="24sp"
                android:gravity="center"
                android:visibility="gone" />

            <!-- 상태 색상 점 (우하단) -->
            <View
                android:id="@+id/view_status_dot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="4dp"
                android:background="@drawable/bg_avatar" />
        </FrameLayout>

        <!-- 텍스트 정보 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_spot_part"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="왼볼"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tv_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tag"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="유지"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_spot_dates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="발견 24.01.01  최근 24.01.15"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />

            <!-- 미니 신뢰도 바 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <ProgressBar
                    android:id="@+id/pb_mini_confidence"
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_weight="1"
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:max="100"
                    android:progress="50"
                    android:progressTint="@color/primary" />

                <TextView
                    android:id="@+id/tv_spot_confidence"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="50%"
                    android:textSize="11sp"
                    android:textColor="@color/text_hint"
                    android:gravity="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_spot_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="3회 관측"
                android:textSize="11sp"
                android:textColor="@color/text_hint" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
