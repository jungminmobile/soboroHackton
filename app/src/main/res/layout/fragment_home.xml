<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <!-- Header -->
        <TextView
            android:id="@+id/tv_greeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_greeting"
            android:textSize="14sp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_subtitle"
            android:textSize="22sp"
            android:textColor="@color/on_background"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <!-- Latest Diagnosis Card -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_latest_diagnosis"
            android:textSize="16sp"
            android:textColor="@color/on_background"
            android:textStyle="bold"
            android:layout_marginTop="28dp" />

        <androidx.cardview.widget.CardView
            android:id="@+id/card_diagnosis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:id="@+id/layout_diagnosis_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Skin Type Badge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_skin_type_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tag"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:text="건성" />

                    <TextView
                        android:id="@+id/tv_diagnosis_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/text_hint"
                        android:textSize="12sp"
                        android:text="2024. 01. 15" />
                </LinearLayout>

                <!-- Scores Grid -->
                <androidx.gridlayout.widget.GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:columnCount="2"
                    app:rowCount="2">

                    <!-- Moisture -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        app:layout_columnWeight="1">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💧 수분"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary" />
                        <TextView
                            android:id="@+id/tv_score_moisture"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="78점"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent_moisture"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Oil -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        app:layout_columnWeight="1">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✨ 유분"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary" />
                        <TextView
                            android:id="@+id/tv_score_oil"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="45점"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent_oil"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Trouble -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        app:layout_columnWeight="1">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔴 트러블"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary" />
                        <TextView
                            android:id="@+id/tv_score_trouble"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="30점"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent_trouble"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Elasticity -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        app:layout_columnWeight="1">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💜 탄력"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary" />
                        <TextView
                            android:id="@+id/tv_score_elasticity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="65점"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent_elasticity"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </androidx.gridlayout.widget.GridLayout>
            </LinearLayout>

            <!-- Empty state -->
            <LinearLayout
                android:id="@+id/layout_diagnosis_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_no_diagnosis"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.5" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Today's Skin Tip -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_tip_title"
            android:textSize="16sp"
            android:textColor="@color/on_background"
            android:textStyle="bold"
            android:layout_marginTop="28dp" />

        <androidx.cardview.widget.CardView
            android:id="@+id/card_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/primary_light">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/tv_tip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="자외선 차단제는 외출 30분 전에 바르는 것이 효과적이에요."
                    android:textSize="14sp"
                    android:textColor="@color/primary_dark"
                    android:lineSpacingMultiplier="1.4" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Quick Action -->
        <Button
            android:id="@+id/btn_quick_scan"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_button_primary"
            android:text="@string/home_scan_btn"
            android:textColor="@color/on_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
