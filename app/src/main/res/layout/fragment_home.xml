<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- ══ ① HEADER — 인사말 + 날짜 + 프로필 ══════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="52dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_greeting"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_background"
                    android:letterSpacing="-0.02" />

                <TextView
                    android:id="@+id/tv_today_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="4dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_avatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_primary"
                    android:background="@drawable/bg_avatar"
                    android:text="S" />

                <TextView
                    android:id="@+id/tv_profile_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="내 정보"
                    android:textSize="10sp"
                    android:textColor="@color/text_hint" />
            </LinearLayout>
        </LinearLayout>

        <!-- ══ ② GRADIENT BANNER ══════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_gradient_banner"
            android:layout_marginHorizontal="16dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="오늘의 피부 상태"
                    android:textSize="13sp"
                    android:textColor="#CCFFFFFF" />

                <TextView
                    android:id="@+id/tv_diagnosis_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="최근 기록 없음"
                    android:textSize="12sp"
                    android:textColor="#AAFFFFFF"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tv_skin_type_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#33FFFFFF"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/tv_acne_count_banner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textSize="42sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="트러블 수"
                    android:textSize="11sp"
                    android:textColor="#CCFFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <!-- ══ ③ SECTION LABEL ════════════════════════════════════ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="고정됨"
            android:textSize="13sp"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary"
            android:letterSpacing="0.06"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="8dp" />

        <!-- ══ ④ CARD 1 — 최근 스캔 결과 ═══════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_diagnosis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface"
            app:strokeWidth="0dp">

            <!-- 데이터 있을 때 -->
            <LinearLayout
                android:id="@+id/layout_diagnosis_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="최근 스캔 결과"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary" />

                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_diary_chevron_right"
                        android:colorFilter="@color/text_hint" />
                </LinearLayout>

                <!-- 점수 그리드 2×2 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="@color/background" android:padding="12dp" android:layout_marginEnd="3dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💧 수분" android:textSize="12sp" android:textColor="@color/text_secondary" />
                            <TextView android:id="@+id/tv_score_moisture" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/accent_moisture" android:layout_marginTop="2dp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="@color/background" android:padding="12dp" android:layout_marginStart="3dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✨ 유분" android:textSize="12sp" android:textColor="@color/text_secondary" />
                            <TextView android:id="@+id/tv_score_oil" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/accent_oil" android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="@color/background" android:padding="12dp" android:layout_marginEnd="3dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔴 트러블" android:textSize="12sp" android:textColor="@color/text_secondary" />
                            <TextView android:id="@+id/tv_score_trouble" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/accent_trouble" android:layout_marginTop="2dp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="@color/background" android:padding="12dp" android:layout_marginStart="3dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💜 탄력" android:textSize="12sp" android:textColor="@color/text_secondary" />
                            <TextView android:id="@+id/tv_score_elasticity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/accent_elasticity" android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 빈 상태 -->
            <LinearLayout
                android:id="@+id/layout_diagnosis_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="28dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📷" android:textSize="36sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_no_diagnosis"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.5"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ══ ⑤ SECTION LABEL ════════════════════════════════════ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="트래킹"
            android:textSize="13sp"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary"
            android:letterSpacing="0.06"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="8dp" />

        <!-- ══ ⑥ CARD 2 — 부위별 현황 ════════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="부위별 현황"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/lavender"
                    android:layout_marginBottom="12dp" />

                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                        <com.google.android.material.chip.Chip android:id="@+id/chip_forehead" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="이마" android:textSize="13sp" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_marginEnd="6dp" app:chipBackgroundColor="@color/lavender_light" app:checkedIconVisible="false" />
                        <com.google.android.material.chip.Chip android:id="@+id/chip_nose" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="코" android:textSize="13sp" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_marginEnd="6dp" app:chipBackgroundColor="@color/lavender_light" app:checkedIconVisible="false" />
                        <com.google.android.material.chip.Chip android:id="@+id/chip_left_cheek" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="왼볼" android:textSize="13sp" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_marginEnd="6dp" app:chipBackgroundColor="@color/lavender_light" app:checkedIconVisible="false" />
                        <com.google.android.material.chip.Chip android:id="@+id/chip_right_cheek" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="오른볼" android:textSize="13sp" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_marginEnd="6dp" app:chipBackgroundColor="@color/lavender_light" app:checkedIconVisible="false" />
                        <com.google.android.material.chip.Chip android:id="@+id/chip_chin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="턱" android:textSize="13sp" style="@style/Widget.MaterialComponents.Chip.Choice" app:chipBackgroundColor="@color/lavender_light" app:checkedIconVisible="false" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ══ ⑦ CARD 3 — 오늘의 피부 팁 ════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <View android:layout_width="4dp" android:layout_height="40dp" android:background="@color/primary" android:layout_marginEnd="12dp" />

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="오늘의 피부 팁" android:textSize="12sp" android:textColor="@color/primary" android:textStyle="bold" />
                    <TextView android:id="@+id/tv_tip" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="@color/on_background" android:lineSpacingMultiplier="1.4" android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ══ ⑧ CARD 4 — 모든 기록 보기 ════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface"
            app:strokeWidth="0dp">

            <LinearLayout
                android:id="@+id/btn_all_records"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="모든 기록 보기" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/on_background" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="기록장에서 전체 히스토리를 확인하세요" android:textSize="12sp" android:textColor="@color/text_secondary" android:layout_marginTop="2dp" />
                </LinearLayout>
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_diary_chevron_right" android:colorFilter="@color/text_hint" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ══ ⑨ 피부 진단 시작 버튼 ════════════════════════════ -->
        <Button
            android:id="@+id/btn_quick_scan"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/bg_gradient_button"
            android:text="@string/home_scan_btn"
            android:textColor="@color/on_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:stateListAnimator="@null" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
